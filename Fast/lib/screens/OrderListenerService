import 'package:supabase_flutter/supabase_flutter.dart';
import 'notification_service.dart';

class OrderListenerService {
  static void listenToOrderStatus(String orderId, String customerPlayerId) {
    Supabase.instance.client
        .from('orders')
        .stream(primaryKey: ['id'])
        .eq('id', orderId)
        .listen((data) {
          if (data.isNotEmpty) {
            final latestOrder = data.first;
            final String status = latestOrder['status'] ?? '';

            // تخصيص النص بناءً على الحالة الحالية للطلب
            if (status == 'pricing_updated') {
              NotificationService.showLocalNotification(
                'تحديث جديد للطلب 🔔',
                'تم تحديد رسوم التوصيل وإجمالي السعر، انقر للموافقة.',
              );
            } else if (status == 'on_the_way') {
              NotificationService.showLocalNotification(
                'المندوب في الطريق 🛵',
                'خرج المندوب لتوصيل طلبك الآن، يرجى الاستعداد.',
              );
            } else if (status == 'delivered') {
              NotificationService.showLocalNotification(
                'تم توصيل الطلب بنجاح ✅',
                'شكراً لاستخدامك فاست ديليفري، نتمنى لك وقتاً سعيداً!',
              );
            }
          }
        });
  }
}
