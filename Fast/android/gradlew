#!/usr/bin/env sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$APP_HOME/gradle/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/gradle-wrapper.jar"
WRAPPER_URL="https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar"
EXPECTED_SHA256="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
mkdir -p "$WRAPPER_DIR"
if [ ! -f "$WRAPPER_JAR" ]; then
  command -v curl >/dev/null 2>&1 || { echo "curl is required to download Gradle Wrapper." >&2; exit 1; }
  TEMP_JAR="$WRAPPER_JAR.tmp"
  curl --fail --location --silent --show-error --retry 3 "$WRAPPER_URL" -o "$TEMP_JAR"
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(sha256sum "$TEMP_JAR" | awk '{print $1}')
  else
    ACTUAL_SHA256=$(shasum -a 256 "$TEMP_JAR" | awk '{print $1}')
  fi
  if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
    rm -f "$TEMP_JAR"
    echo "Gradle Wrapper JAR checksum mismatch; refusing to execute it." >&2
    exit 1
  fi
  mv "$TEMP_JAR" "$WRAPPER_JAR"
fi
exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -Dorg.gradle.appname=gradlew -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
