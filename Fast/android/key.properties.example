# Copy this file to android/key.properties and replace every placeholder.
# Keep key.properties and the keystore private; never commit them to Git.
# storeFile is relative to the android/ directory, or it may be an absolute path.
storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
